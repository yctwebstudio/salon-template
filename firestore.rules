rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 預約：已登入可讀，寫入走 Admin SDK
    match /bookings/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // 設計師：公開讀（前台預約頁），寫入走 Admin SDK
    match /designers/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /designers/{id}/services/{serviceId} {
      allow read: if true;
      allow write: if false;
    }
    match /designers/{id}/schedules/{day} {
      allow read: if true;
      allow write: if false;
    }
    match /designers/{id}/exceptions/{date} {
      allow read: if true;
      allow write: if false;
    }

    // 服務類別：公開讀
    match /services/{id} {
      allow read: if true;
      allow write: if false;
    }

    // 設定：公開讀（前台時段計算需要）
    match /settings/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // 客戶資料庫：僅登入可讀（後台專用）
    match /customers/{phone} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // 其餘拒絕
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
